{
  "appId": "br.com.clara.desktop",
  "productName": "MedFast",
  "directories": { "output": "release", "buildResources": "build" },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "src/data/store-core.js",
    "firebase.config.json",
    "build/icon.ico",
    "package.json"
  ],
  "asar": true,
  "npmRebuild": false,
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] },
      { "target": "portable", "arch": ["x64"] }
    ],
    "icon": "build/icon.ico",
    "signAndEditExecutable": true
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "artifactName": "MedFast-Instalador-${version}-${arch}.${ext}"
  },
  "portable": { "artifactName": "MedFast-Portatil-${version}-${arch}.${ext}" }
}
